<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- NINA cible net10.0-windows (WPF) : le service doit cibler la même chose pour le référencer. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- À épingler sur une version précise une fois choisie (vérifier la dernière sur NuGet). -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Le contrat partagé avec Python : jamais copié, toujours référencé. -->
    <Protobuf Include="..\..\proto\startracker\devices\v1\devices.proto"
              ProtoRoot="..\..\proto" GrpcServices="Server" />
  </ItemGroup>

  <!--
    ÉTAPE 2 (après le premier test) : activer NINA en passant le chemin du dépôt cloné
      dotnet build -p:NinaRoot=C:\src\nina
    Sans NinaRoot le service compile mais n'expose aucun appareil.
  -->
  <PropertyGroup Condition="'$(NinaRoot)' != ''">
    <DefineConstants>$(DefineConstants);NINA</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(NinaRoot)' != ''">
    <ProjectReference Include="$(NinaRoot)\NINA.Equipment\NINA.Equipment.csproj" />
    <ProjectReference Include="$(NinaRoot)\NINA.Profile\NINA.Profile.csproj" />
    <ProjectReference Include="$(NinaRoot)\NINA.Astrometry\NINA.Astrometry.csproj" />
    <ProjectReference Include="$(NinaRoot)\NINA.Core\NINA.Core.csproj" />
  </ItemGroup>

</Project>
